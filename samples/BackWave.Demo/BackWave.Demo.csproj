<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- A deployed artifact, not a NuGet package: never packed or referenced by the library. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The exact adapter set the demo deploys: SQLite Embedded Adapter, the base + Pro dashboards,
         the Pro MCP server (read-only for the public demo), and the hosting glue. No Postgres/
         SqlServer/EF/Swashbuckle — the demo is SQLite-only, root-mounted, and carries no HTTP API
         surface of its own beyond the dashboard and the MCP endpoint. -->
    <ProjectReference Include="..\..\src\BackWave\BackWave.csproj" />
    <ProjectReference Include="..\..\src\BackWave.Pro\BackWave.Pro.csproj" />
    <ProjectReference Include="..\..\src\BackWave.Pro.Mcp\BackWave.Pro.Mcp.csproj" />
    <ProjectReference Include="..\..\src\BackWave.Hosting\BackWave.Hosting.csproj" />
    <ProjectReference Include="..\..\src\BackWave.Sqlite\BackWave.Sqlite.csproj" />
    <ProjectReference Include="..\..\src\BackWave.Dashboard\BackWave.Dashboard.csproj" />
    <ProjectReference Include="..\..\src\BackWave.Pro.Dashboard\BackWave.Pro.Dashboard.csproj" />
    <ProjectReference Include="..\..\src\BackWave.SourceGenerators\BackWave.SourceGenerators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
