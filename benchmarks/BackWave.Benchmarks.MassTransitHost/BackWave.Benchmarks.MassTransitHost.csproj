<Project Sdk="Microsoft.NET.Sdk">

  <!-- The MassTransit competitor host. It is a separate executable because MassTransit.SqlTransport.PostgreSql
       requires Dapper 2.1.89 or later, while Hangfire.PostgreSql in the harness resolves Dapper 2.0.123; in one
       executable MassTransit would move Hangfire onto a Dapper it was never measured on. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <RootNamespace>BackWave.Benchmarks.MassTransitHost</RootNamespace>
  </PropertyGroup>

  <!-- 8.x is the last Apache-2.0 MassTransit line; 9.x is commercial and refuses to start without a license
       key. The transport floor is Npgsql 8.0.7, so Npgsql is pinned to the harness's 9.0.3 and MassTransit
       talks to Postgres through the same driver version as BackWave, Hangfire, and Quartz.NET. -->
  <ItemGroup>
    <PackageReference Include="MassTransit" Version="8.5.12" />
    <PackageReference Include="MassTransit.SqlTransport.PostgreSql" Version="8.5.12" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Npgsql" Version="9.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\BackWave.Benchmarks\Workload\WorkloadSpec.cs" Link="Shared\WorkloadSpec.cs" />
    <Compile Include="..\BackWave.Benchmarks\Workload\ParallelProducer.cs" Link="Shared\ParallelProducer.cs" />
    <Compile Include="..\BackWave.Benchmarks\Workload\CompletionLog.cs" Link="Shared\CompletionLog.cs" />
    <Compile Include="..\BackWave.Benchmarks\Targets\MassTransitHostProtocol.cs" Link="Shared\MassTransitHostProtocol.cs" />
  </ItemGroup>

</Project>
