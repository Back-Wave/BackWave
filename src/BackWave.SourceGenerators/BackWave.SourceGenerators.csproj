<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Source generators for BackWave: job registry, serialization, and [Job] method sugar.</Description>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <!-- Not shipped as its own package: the generated code (registry, serialization, [Job] sugar)
         calls BackWave runtime APIs and must never version-skew from them. The BackWave package packs
         this generator's dll into analyzers/dotnet/cs so a plain `dotnet add package BackWave` gets it. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

</Project>
