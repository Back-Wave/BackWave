<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>SQL Server storage adapter for BackWave: versioned SQL schema, UPDLOCK/READPAST claims, Transactional Enqueue.</Description>
    <PackageTags>$(PackageTags);sql-server;mssql;sqlclient</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BackWave\BackWave.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BackWave.SqlServer.Tests" />
    <InternalsVisibleTo Include="BackWave.EntityFrameworkCore.Tests" />
    <InternalsVisibleTo Include="BackWave.Conformance" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.1" />
  </ItemGroup>

  <!-- Microsoft.Data.SqlClient 6.1.1 depends on a System.Security.Cryptography.Pkcs release with known
       vulnerabilities (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7). Pin the patched release for each target. -->
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="8.0.2" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="9.0.21" Condition="'$(TargetFramework)' == 'net9.0'" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" Condition="'$(TargetFramework)' == 'net10.0'" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Schema\*.sql" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework></TargetFramework>
    <TargetFrameworks>$(ShipTfms)</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
