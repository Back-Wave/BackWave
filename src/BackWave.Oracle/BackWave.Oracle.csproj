<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Oracle storage adapter for BackWave: versioned SQL schema, FOR UPDATE SKIP LOCKED claims, Transactional Enqueue.</Description>
    <PackageTags>$(PackageTags);oracle;odp.net;oracle-19c</PackageTags>
    <!-- Oracle.ManagedDataAccess.Core is not trim/AOT-clean (reflection + Assembly.Location on core paths),
         so this adapter is intentionally outside the Native-AOT tier: IsAotCompatible is NOT set. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BackWave\BackWave.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Test-only failpoint (OracleStoreOptions.FaultHook) and the internal SchemaRewriter/diagnostics
         are reached by the adapter's own suite and the shared conformance harness. -->
    <InternalsVisibleTo Include="BackWave.Oracle.Tests" />
    <InternalsVisibleTo Include="BackWave.Conformance" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Oracle.ManagedDataAccess.Core" Version="23.9.1" />
  </ItemGroup>

  <!-- Oracle.ManagedDataAccess.Core 23.9.1 depends on a System.Security.Cryptography.Pkcs release with known
       vulnerabilities (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7). Pin the patched release for each target. -->
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="8.0.2" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="9.0.21" Condition="'$(TargetFramework)' == 'net9.0'" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" Condition="'$(TargetFramework)' == 'net10.0'" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Schema\*.sql" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework></TargetFramework>
    <TargetFrameworks>$(ShipTfms)</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
