@* The copy affordance shared by every copyable block (payload, output, Failure Detail):
   a [data-bw-copy] button the layout's one delegated listener wires up — on click it copies
   the sibling <pre>'s textContent from the enclosing .bw-codeblock. Progressive enhancement:
   without JS the button simply does nothing, the block still shows. Place it as a sibling of
   the <pre> inside a .bw-codeblock (or inside a .bw-fence__bar). *@
<button type="button" class="bw-copy" data-bw-copy aria-label="Copy @Label" title="Copy @Label">
    <svg class="bw-copy__copy" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 15C9 12.1716 9 10.7574 9.87868 9.87868C10.7574 9 12.1716 9 15 9H16C18.8284 9 20.2426 9 21.1213 9.87868C22 10.7574 22 12.1716 22 15V16C22 18.8284 22 20.2426 21.1213 21.1213C20.2426 22 18.8284 22 16 22H15C12.1716 22 10.7574 22 9.87868 21.1213C9 20.2426 9 18.8284 9 16V15Z"/><path d="M16.9999 9C16.9975 6.04291 16.9528 4.51121 16.092 3.46243C15.9258 3.25989 15.7401 3.07418 15.5376 2.90796C14.4312 2 12.7875 2 9.5 2C6.21252 2 4.56878 2 3.46243 2.90796C3.25989 3.07418 3.07418 3.25989 2.90796 3.46243C2 4.56878 2 6.21252 2 9.5C2 12.7875 2 14.4312 2.90796 15.5376C3.07418 15.7401 3.25989 15.9258 3.46243 16.092C4.51121 16.9528 6.04291 16.9975 9 16.9999"/></svg>
    <svg class="bw-copy__check" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13.5L9 17.5L19 6.5"/></svg>
</button>

@code {
    /// <summary>What the button copies, woven into the accessible label and tooltip as
    /// "Copy {Label}" — e.g. <c>payload</c>, <c>output</c>, <c>failure detail</c>.</summary>
    [Parameter, EditorRequired] public string Label { get; set; } = "";
}
