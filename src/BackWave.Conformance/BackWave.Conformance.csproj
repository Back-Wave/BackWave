<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>The Storage Contract Conformance Suite: subclass ConformanceSuite with a store factory to certify an adapter.</Description>
    <PackageTags>$(PackageTags);testing;conformance;storage-adapter;xunit</PackageTags>
    <TargetFramework></TargetFramework>
    <TargetFrameworks>$(ShipTfms)</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- A library of abstract suites — adapters run them; dotnet test must not try to. -->
    <IsTestProject>false</IsTestProject>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit" Version="2.9.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BackWave\BackWave.csproj" />
  </ItemGroup>

</Project>
