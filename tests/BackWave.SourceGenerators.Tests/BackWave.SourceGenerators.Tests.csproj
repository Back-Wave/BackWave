<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Runs on every shipped TFM: the tests compile payloads against the BCL and the System.Text.Json source
         generator of the framework they run on, and STJ behavior differs between versions. -->
    <TargetFramework></TargetFramework>
    <TargetFrameworks>$(ShipTfms)</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <!-- The code-fix harness drives a CodeFixProvider through an AdhocWorkspace, which needs Workspaces. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.14.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BackWave\BackWave.csproj" />
    <!-- The workflow markers the codec generator keys off live in BackWave.Pro; a workflow fixture references them. -->
    <ProjectReference Include="..\..\src\BackWave.Pro\BackWave.Pro.csproj" />
    <ProjectReference Include="..\..\src\BackWave.SourceGenerators\BackWave.SourceGenerators.csproj" />
    <ProjectReference Include="..\..\src\BackWave.SourceGenerators.CodeFixes\BackWave.SourceGenerators.CodeFixes.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Snapshots\**" />
    <None Include="Snapshots\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    The real System.Text.Json source generator, from the targeting pack of this framework. The harness runs it
    beside the BackWave generator, so a test can compile a payload with delegated members end to end.
  -->
  <Target Name="CopyJsonSourceGenerator" AfterTargets="ResolveTargetingPackAssets">
    <ItemGroup>
      <None Include="@(Analyzer)" Condition="'%(Filename)' == 'System.Text.Json.SourceGeneration'"
            Link="JsonSourceGenerator\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
