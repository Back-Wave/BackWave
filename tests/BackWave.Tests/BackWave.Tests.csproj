<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="CsCheck" Version="4.7.0" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <!-- Workflows are a BackWave Pro feature: the build/enqueue/cancel surface lives in BackWave.Pro
         as extension methods, so workflow tests reference it. -->
    <Using Include="BackWave.Pro" />
  </ItemGroup>

  <ItemGroup>
    <!-- Checked-in VOPR regression fixtures (issue 0089): minimized Plan JSON replayed by RegressionFixturesTests. -->
    <None Include="Simulation/fixtures/**/*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BackWave\BackWave.csproj" />
    <ProjectReference Include="..\..\src\BackWave.Pro\BackWave.Pro.csproj" />
    <ProjectReference Include="..\..\src\BackWave.Testing\BackWave.Testing.csproj" />
    <ProjectReference Include="..\..\tests\BackWave.Simulation\BackWave.Simulation.csproj" />
    <ProjectReference Include="..\..\src\BackWave.Conformance\BackWave.Conformance.csproj" />
    <ProjectReference Include="..\..\src\BackWave.SourceGenerators\BackWave.SourceGenerators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>